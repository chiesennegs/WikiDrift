{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wikidrift",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "build": { "command": "npm run assets", "watch_dir": "client" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "WIKIMEDIA_CONTACT": "https://github.com/chiesennegs/WikiDrift"
  },
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "60701", "simple": { "limit": 6, "period": 60 } }
  ]
}
